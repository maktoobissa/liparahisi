# Copy this file to .env.
# Demo mode works locally without payment credentials.
DEMO_MODE=true

# Add these values only after demo work is complete.
# Copy this file to .env and fill in the values from your Selcom sandbox account.
# Use the exact HTTPS API base URL provided by Selcom for your sandbox account.
SELCOM_BASE_URL=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=

# Long random value for protecting the merchant product-creation form.
MERCHANT_ADMIN_TOKEN=

# Public HTTPS origin serving this app, with no trailing slash.
# For local phone testing, use your computer's reachable LAN address instead.
PUBLIC_APP_URL=

# Optional path to the SQLite database.
# DATABASE_PATH=backend/data.sqlite3
