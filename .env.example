# Copy this file to .env.
# Local demo uses SQLite unless DATABASE_URL is set.
DEMO_MODE=true
ADMIN_SETUP_TOKEN=
DATABASE_URL=
# Optional Render Key Value connection; omit both to disable Redis caching.
REDIS_HOST=
REDIS_PORT=

# MFA secrets are encrypted with this Fernet key. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Separate key for encrypted KYC seller documents. Use a Fernet key.
SELLER_KYC_ENCRYPTION_KEY=

# S3-compatible automated database snapshots (daily; private bucket required).
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=liparahisi
BACKUP_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# ClickPesa credentials are server-side only. Keep demo mode enabled until
# merchant KYC, webhook checksum, and manual seller payouts are configured.
SELCOM_BASE_URL=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_CHECKSUM_KEY=
CLICKPESA_LIVE_ENABLED=false
CLICKPESA_MANUAL_PAYOUTS_CONFIRMED=false

# PesaPal is sandbox-only and requires DEMO_MODE=true.
PESAPAL_SANDBOX_ENABLED=false
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_NOTIFICATION_ID=

# Abliner is production-only and requires both server-side secrets.
# Do not enable live payments until a durable production database is ready.
ABLINER_LIVE_ENABLED=false
ABLINER_API_KEY=
ABLINER_WEBHOOK_SECRET=

# Email delivery. Use Resend over HTTPS on Render; SMTP can remain for local use.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_FROM=

# SMTP fallback for local environments that permit outbound SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# Notification channels. Credentials are server-only.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v22.0
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
FCM_SERVER_KEY=

# Local Docker Compose only; replace the development token before sharing a stack.
NOTIFICATION_SERVICE_TOKEN=local-dev-token-change-me
ADMIN_SERVICE_TOKEN=local-admin-api-token-change-me
CATALOG_SERVICE_TOKEN=local-catalog-api-token-change-me
IDENTITY_SERVICE_TOKEN=local-identity-api-token-change-me
ORDERS_SERVICE_TOKEN=local-orders-api-token-change-me
LOCAL_DB_PASSWORD=local-only-change-me

# Optional fraud review enrichment. With no key, local rules continue normally.
# Only aggregated event counts and signal categories are sent; no account IDs,
# names, email addresses, IP addresses, or free-text user content are included.
OPENAI_API_KEY=
OPENAI_FRAUD_MODEL=gpt-4o-mini
# Optional business assistant recommendations; factual metrics are calculated locally.
BUSINESS_AI_PROVIDER=openai
OPENAI_BUSINESS_MODEL=gpt-4o-mini

# Public HTTPS origin serving this app, with no trailing slash.
# For local phone testing, use your computer's reachable LAN address instead.
FRONTEND_URL=
BACKEND_URL=
# Backward-compatible fallback for FRONTEND_URL.
PUBLIC_APP_URL=

# Optional path to the SQLite database.
# DATABASE_PATH=backend/data.sqlite3
