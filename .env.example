# Copy this file to .env.
# Local demo uses SQLite unless DATABASE_URL is set.
DEMO_MODE=true
ADMIN_SETUP_TOKEN=
DATABASE_URL=

# Real marketplace payments are intentionally disabled until seller-specific
# payment accounts and provider settlement are integrated and verified.
SELCOM_BASE_URL=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=

# Public HTTPS origin serving this app, with no trailing slash.
# For local phone testing, use your computer's reachable LAN address instead.
PUBLIC_APP_URL=

# Optional path to the SQLite database.
# DATABASE_PATH=backend/data.sqlite3
