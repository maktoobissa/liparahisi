# Copy this file to .env.
# Local demo uses SQLite unless DATABASE_URL is set.
DEMO_MODE=true
ADMIN_SETUP_TOKEN=
DATABASE_URL=
# Optional Render Key Value connection; omit both to disable Redis caching.
REDIS_HOST=
REDIS_PORT=

# ClickPesa credentials are server-side only. Keep demo mode enabled until
# merchant KYC, webhook checksum, and manual seller payouts are configured.
SELCOM_BASE_URL=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR=
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_CHECKSUM_KEY=
CLICKPESA_LIVE_ENABLED=false
CLICKPESA_MANUAL_PAYOUTS_CONFIRMED=false

# Email delivery. Use Resend over HTTPS on Render; SMTP can remain for local use.
EMAIL_PROVIDER=smtp
RESEND_API_KEY=
EMAIL_FROM=

# SMTP fallback for local environments that permit outbound SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false

# Local Docker Compose only; replace the development token before sharing a stack.
NOTIFICATION_SERVICE_TOKEN=local-dev-token-change-me
ADMIN_SERVICE_TOKEN=local-admin-api-token-change-me
CATALOG_SERVICE_TOKEN=local-catalog-api-token-change-me
IDENTITY_SERVICE_TOKEN=local-identity-api-token-change-me
ORDERS_SERVICE_TOKEN=local-orders-api-token-change-me
LOCAL_DB_PASSWORD=local-only-change-me

# Public HTTPS origin serving this app, with no trailing slash.
# For local phone testing, use your computer's reachable LAN address instead.
FRONTEND_URL=
BACKEND_URL=
# Backward-compatible fallback for FRONTEND_URL.
PUBLIC_APP_URL=

# Optional path to the SQLite database.
# DATABASE_PATH=backend/data.sqlite3
